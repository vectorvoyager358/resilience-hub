{
  "name": "resilience-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:server": ".venv/bin/python -m unittest discover -s tests/backend -p 'test_*.py' -t .",
    "eval:chat": ".venv/bin/python scripts/run_chat_eval.py",
    "eval:chat:mock": ".venv/bin/python scripts/run_chat_eval.py --mock-chat",
    "eval:chat:ragas": ".venv/bin/python scripts/run_chat_eval.py --ragas",
    "eval:chat:ragas:live": ".venv/bin/python scripts/run_chat_eval.py --live --ragas",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "audit:ci": "audit-ci --config audit-ci.jsonc",
    "lint": "eslint \"**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"**/*.{ts,tsx}\" --fix",
    "lint:watch": "eslint \"**/*.{ts,tsx}\" --watch",
    "preview": "vite preview",
    "server:dev": ".venv/bin/python -m server.app"
  },
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.14.1",
    "@firebase/firestore": "^4.17.1",
    "@mui/icons-material": "^5.17.1",
    "@mui/material": "^5.17.1",
    "@mui/x-date-pickers": "^7.29.4",
    "chart.js": "^4.5.1",
    "firebase": "^11.6.1",
    "framer-motion": "^12.41.0",
    "fuse.js": "^7.5.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "react-firebase-hooks": "^5.1.1",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.15.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/ui": "^3.2.6",
    "audit-ci": "7.1.0",
    "bidi-js": "^1.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.6"
  }
}
