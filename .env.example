# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_VAPID_KEY=your_web_push_vapid_key_here

# Flask server: chat assistant + embeddings (server-side ONLY — must NOT be exposed to the browser).
# Generate at https://aistudio.google.com/app/apikey and add IP/API restrictions.
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin (Flask): MUST match VITE_FIREBASE_PROJECT_ID or verify_id_token() fails → 401 on /api/chat-assistant
# FIREBASE_PROJECT_ID=your_project_id_here
# Use a service account key from Firebase Console → Project settings → Service accounts, or: gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json

# Cloud Run / local Flask — full origin, no trailing slash (omit for local dev + Vite proxy)
# VITE_API_BASE_URL=https://your-api-xxxxx.run.app

# GitHub Pages / subpath hosting — leading slash + repo folder + trailing slash (omit for local dev)
# VITE_BASE_PATH=/resilience-hub/

# Cloud Run scheduled reminders (server-side)
# CRON_KEY=choose_a_long_random_secret
# REMINDER_WINDOW_MINUTES=10

# /api/chat-assistant (Gemini + optional Pinecone RAG):
# Server-side enforcement: callers must have Firebase `email_verified=true`.
# Rate limiting caps expensive calls (per-UID and per-IP).
CHAT_UID_RATE_CAPACITY=3
CHAT_UID_RATE_REFILL_PER_SEC=0.5
CHAT_IP_RATE_CAPACITY=10
CHAT_IP_RATE_REFILL_PER_SEC=1
# Observability (prompts can contain user text — avoid full logging in production):
# LOG_LEVEL=DEBUG
# CHAT_LOG_PROMPT_PREVIEW_CHARS=800
# CHAT_LOG_FULL_PROMPT=1

