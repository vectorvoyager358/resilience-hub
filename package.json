{
  "name": "resilience-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:server": ".venv/bin/python -m unittest discover -s tests/backend -p 'test_*.py' -t .",
    "eval:chat": ".venv/bin/python scripts/run_chat_eval.py",
    "eval:chat:mock": ".venv/bin/python scripts/run_chat_eval.py --mock-chat",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint . --no-eslintrc --config .eslintrc.cjs --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --no-eslintrc --config .eslintrc.cjs --ext ts,tsx --fix",
    "lint:watch": "eslint . --no-eslintrc --config .eslintrc.cjs --ext ts,tsx --watch",
    "preview": "vite preview",
    "server:dev": ".venv/bin/python -m server.app"
  },
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.14.1",
    "@firebase/firestore": "^4.16.0",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^5.15.10",
    "@mui/x-date-pickers": "^6.19.7",
    "@types/jspdf": "^1.3.3",
    "chart.js": "^4.5.1",
    "firebase": "^11.6.1",
    "framer-motion": "^12.41.0",
    "fuse.js": "^7.4.2",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "react-firebase-hooks": "^5.1.1",
    "react-router-dom": "^7.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "@vitest/ui": "^4.1.9",
    "bidi-js": "^1.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^27.0.1",
    "typescript": "^5.2.2",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  }
}
